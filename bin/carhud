#!/usr/bin/env node
'use strict';
/**
 * carhud: control the CarHUD from the command line (on the Pi, or anywhere with CARHUD_URL set).
 * Run `carhud help` for the commands.
 */
const http = require('http');
const path = require('path');
const fs = require('fs');
const { spawnSync } = require('child_process');

const ROOT = path.join(fs.realpathSync(__filename), '..', '..');
let port = 8078;
try { port = Number(require(path.join(ROOT, 'server', 'config')).load().port) || 8078; } catch (e) { /* defaults */ }
const BASE = process.env.CARHUD_URL || 'http://127.0.0.1:' + port;

const HELP = `carhud: control the car HUD

  carhud status                 what's running: source, app, OBD, values
  carhud source <name>          auto | demo | manual | obd
  carhud hold                   freeze what the HUD shows now (switches to manual)
  carhud set k=v [k=v ...]      manual values, e.g. carhud set rpm=6500 speed=110 gear=3
                                (rpm speed gear coolant oil boost torque pedal gLong gLat afr fuel knock burn)
  carhud reset                  manual values back to defaults
  carhud drive <mode>           none | comfort | sport | sport+ | eco
  carhud settings               the HUD app's settings and their current values
  carhud setting <key> <value>  change one, e.g. carhud setting redline 6500
  carhud obd                    adapter, protocol and every PID reading
  carhud phone                  Bluetooth phone, music, notifications, GPS and route
  carhud phone --check          find out why Bluetooth / pairing isn't working
  carhud pair                   let a new phone pair for 3 minutes (confirm the code on the desk)
  carhud play|pause|next|prev   the phone's music
  carhud wifi                   Wi-Fi status and the hotspot's settings
  carhud wifi hotspot [min]     switch to the car hotspot (min: back to home Wi-Fi after that long)
  carhud wifi home              back to home Wi-Fi
  carhud wifi log               what happened, and why a switch failed
  carhud nav test [kmh]|stop|end   a test route where you are and a pretend drive along it
  carhud watch                  live values, refreshed (Ctrl+C to stop)
  carhud log [-f]               the server log (-f: keep following)
  carhud restart [--rebuild]    restart the HUD app (--rebuild: rebuild it first)
  carhud reload                 reload every HUD and desk screen
  carhud screens [args]         reopen the screens (same as carhud-screens)
  carhud update                 get the newest CarHUD from GitHub and apply it
  carhud gears <final> <tyre> <ratio1> <ratio2> ...
                                work out OBD_GEAR_RATIOS, e.g.
                                carhud gears 4.111 245/40R18 3.454 1.947 1.296 0.972 0.780 0.666
  carhud url                    the addresses of the control panel
`;

function req(method, p, body) {
    return new Promise((resolve, reject) => {
        const data = body === undefined ? null : Buffer.from(JSON.stringify(body));
        const r = http.request(BASE + p, { method, headers: data ? { 'content-type': 'application/json', 'content-length': data.length } : {} }, (res) => {
            let s = ''; res.on('data', (d) => { s += d; });
            res.on('end', () => { try { resolve(JSON.parse(s || '{}')); } catch (e) { resolve({ raw: s }); } });
        });
        r.on('error', (e) => reject(new Error('cannot reach the carhud server at ' + BASE + ' (' + e.code + '). Is it running?  sudo systemctl status carhud')));
        if (data) r.write(data);
        r.end();
    });
}
const get = (p) => req('GET', p);
const post = (p, b) => req('POST', p, b || {});
const n = (v, d) => (typeof v === 'number' && isFinite(v) ? v.toFixed(d || 0) : '--');
const pad = (s, w) => String(s).padEnd(w);
const DRIVES = { none: null, comfort: 4, sport: 1, 'sport+': 2, sportplus: 2, eco: 7, ecopro: 7 };

function valuesLine(v) {
    const h = v.hud || {};
    const g = Math.round(h.gear);
    return 'rpm ' + n(h.rpm) + '  speed ' + n(h.speed) + ' km/h  gear ' + (isNaN(g) ? '-' : g < 0 ? 'R' : g === 0 ? 'P' : g) +
        '  coolant ' + n(h.coolant) + '°C  oil ' + n(h.oil) + '°C  boost ' + n(h.boost, 2) + ' bar  gLong ' + n(h.gLong, 2);
}

async function main() {
    const [cmd, ...args] = process.argv.slice(2);
    switch (cmd) {
        case undefined: case 'help': case '-h': case '--help': process.stdout.write(HELP); return;
        case 'status': {
            const [s, v] = await Promise.all([get('/api/state'), get('/api/values')]);
            console.log('CarHUD ' + s.version + '   HUD app: ' + s.app);
            console.log('source: ' + s.source + (s.auto ? ' (auto)' : '') + '   drive mode: ' + (s.drive === null ? 'not sent' : s.drive));
            console.log('OBD: ' + s.obd.state + (s.obd.detail ? ' (' + s.obd.detail + ')' : ''));
            console.log(valuesLine(v));
            return;
        }
        case 'source': {
            if (!args[0]) throw new Error('carhud source auto|demo|manual|obd');
            const s = await post('/api/source', { source: args[0] });
            console.log('source: ' + s.source + (s.auto ? ' (auto)' : ''));
            return;
        }
        case 'hold': { await post('/api/hold'); console.log('held: the HUD keeps showing these values (carhud source demo|obd to go back)'); return; }
        case 'set': {
            const values = {};
            args.forEach((a) => { const m = a.match(/^(\w+)=(-?[\d.]+)$/); if (!m) throw new Error('not key=value: ' + a); values[m[1]] = Number(m[2]); });
            const s = await post('/api/manual', { values });
            console.log('manual: ' + Object.entries(s.manual).map(([k, v]) => k + '=' + v).join(' '));
            return;
        }
        case 'reset': { await post('/api/manual', { reset: true }); console.log('manual values reset'); return; }
        case 'drive': {
            const k = String(args[0] || '').toLowerCase();
            if (!(k in DRIVES)) throw new Error('carhud drive none|comfort|sport|sport+|eco');
            await post('/api/drive', { value: DRIVES[k] }); console.log('drive mode: ' + k);
            return;
        }
        case 'settings': {
            const s = await get('/api/settings');
            if (!s.schema) throw new Error('the HUD app is not running yet');
            s.schema.forEach((x) => {
                const opts = x.type === 'bool' ? 'true|false' : x.type === 'choice' ? x.options.map((o) => o[0]).join('|') : x.steps.join('|');
                console.log(pad(x.key, 18) + pad(JSON.stringify(s.values[x.key]), 12) + x.label + '   [' + opts + ']');
            });
            return;
        }
        case 'setting': {
            if (args.length < 2) throw new Error('carhud setting <key> <value>');
            let v = args[1];
            if (v === 'true' || v === 'false') v = v === 'true'; else if (/^-?\d+(\.\d+)?$/.test(v)) { const s = await get('/api/settings'); const def = (s.schema || []).find((x) => x.key === args[0]); if (def && def.type === 'number') v = Number(v); }
            const r = await post('/api/setting', { key: args[0], value: v });
            if (r.error) throw new Error(r.error);
            console.log(args[0] + ' = ' + JSON.stringify(v));
            return;
        }
        case 'obd': {
            const s = await get('/api/obd'); const i = s.info || {};
            console.log('state:    ' + s.state + (s.detail ? ' (' + s.detail + ')' : ''));
            console.log('device:   ' + (i.device || '--') + (i.baud ? ' @ ' + i.baud : '') + '   adapter: ' + (i.version || '--'));
            console.log('protocol: ' + (i.protocol || '--') + '   battery: ' + (i.volts ? i.volts + ' V' : '--') + '   poll: ' + (s.roundHz || '--') + ' rounds/s' + (s.multi ? ' (multi-PID)' : ''));
            if (s.pids.length) console.log();
            s.pids.forEach((p) => console.log('  ' + p.pid + '  ' + pad(p.label, 30) + pad(p.value === undefined ? '--' : (Math.abs(p.value) >= 100 ? Math.round(p.value) : Math.round(p.value * 10) / 10) + ' ' + p.unit, 16) + (p.hz ? p.hz + '/s' : '') + (p.dead ? '  (no answer)' : '')));
            const v = await get('/api/values');
            if (v.ratio !== null && v.ratio !== undefined) console.log('\nrpm per km/h now: ' + v.ratio + '  →  gear ' + (v.derived.gear || '?'));
            return;
        }
        case 'watch': {
            for (;;) {
                const [s, v] = await Promise.all([get('/api/state'), get('/api/values')]);
                process.stdout.write('\x1b[2K\r[' + s.source + (s.auto ? '/auto' : '') + ' · obd ' + s.obd.state + '] ' + valuesLine(v) + (v.ratio ? '  rpm/kmh ' + v.ratio : ''));
                await new Promise((r) => setTimeout(r, 300));
            }
        }
        case 'log': {
            let seen = 0;
            const show = (l) => l.slice(seen).forEach((e) => console.log(new Date(e.time).toTimeString().slice(0, 8) + ' ' + pad(e.level, 5) + ' ' + e.text));
            let logs = await get('/api/logs'); show(logs); seen = logs.length;
            if (args[0] !== '-f') return;
            let last = logs.length ? logs[logs.length - 1].time : 0;
            for (;;) {
                await new Promise((r) => setTimeout(r, 1000));
                logs = await get('/api/logs');
                const fresh = logs.filter((e) => e.time > last);
                fresh.forEach((e) => console.log(new Date(e.time).toTimeString().slice(0, 8) + ' ' + pad(e.level, 5) + ' ' + e.text));
                if (fresh.length) last = fresh[fresh.length - 1].time;
            }
        }
        case 'phone': {
            if (args[0] === '--check') return btCheck();
            const p = await get('/api/phone'), bt = p.bt || {}, d = (bt.devices || []).find((x) => x.connected);
            console.log('Bluetooth: ' + (!bt.available ? 'not running (see carhud log)' : !bt.adapter ? 'no adapter' : 'on as "' + bt.adapter.name + '"' + (bt.adapter.discoverable ? ', visible to phones' : '')));
            (bt.devices || []).forEach((x) => console.log('  ' + (x.connected ? '● ' : '○ ') + x.name + '  ' + x.address + (x.battery !== null && x.battery !== undefined ? '  battery ' + x.battery + '%' : '') + (x.notifications ? '  notifications' : '')));
            if (!d) console.log('  no phone connected');
            const m = bt.media;
            if (m && m.title) console.log('playing:   ' + m.title + (m.artist ? ' · ' + m.artist : '') + ' (' + m.status + (m.app ? ', ' + m.app : '') + ')');
            if (p.notifications.length) console.log('notices:   ' + p.notifications.slice(0, 3).map((x) => (x.appName || '') + ': ' + (x.title || '')).join(' | '));
            const g = p.gps;
            console.log('GPS:       ' + (g ? (g.fresh ? (g.sim ? 'simulated, ' : 'from the phone, ') : 'stopped ' + Math.round(g.age / 1000) + ' s ago, ') + Math.round(g.speed || 0) + ' km/h' : 'no phone sharing location'));
            const n = p.nav && p.nav.progress;
            console.log('route:     ' + (p.nav ? (p.nav.dest && p.nav.dest.name) + (n ? ', ' + n.left + ' m left' + (n.next ? ', next: ' + (n.next.text || n.next.type) + ' in ' + n.next.distance + ' m' : '') : '') : 'none'));
            const c = p.config || {};
            console.log('phone app: https://' + c.hostname + '.local:' + c.httpsPort + '/phone/   (setup: http://' + c.hostname + '.local:' + c.httpPort + '/phone/setup.html)');
            return;
        }
        case 'pair': {
            const r = await post('/api/phone/discoverable', { on: true, seconds: 180 });
            if (r.error) throw new Error(r.error);
            console.log('Visible as "' + r.name + '" for 3 minutes. On the phone: Settings → Bluetooth → ' + r.name + ', tap Pair.');
            console.log('Waiting for a phone (Ctrl+C to stop)...');
            const rl = require('readline').createInterface({ input: process.stdin, output: process.stdout });
            let lastKey = null; const end = Date.now() + 180000;
            for (;;) {
                if (Date.now() > end) { console.log('pairing window closed'); break; }
                const p = await get('/api/phone'), lp = p.lastPair;
                if (lp && lp.at > Date.now() - 200000 && JSON.stringify(lp) !== lastKey) {
                    lastKey = JSON.stringify(lp);
                    if (lp.done) { console.log(lp.ok ? '✓ paired with ' + lp.name : '✗ pairing with ' + lp.name + ' failed or was declined'); if (lp.ok) break; }
                    else if (lp.auto) console.log('… ' + lp.name + ' is pairing' + (lp.passkey ? ', code ' + lp.passkey + ': tap Pair on the phone' : ''));
                }
                if (p.pairing) {
                    const a = await new Promise((res) => rl.question('Pair with ' + p.pairing.name + (p.pairing.passkey ? ' (code ' + p.pairing.passkey + ')' : '') + '? [y/n] ', res));
                    await post('/api/phone/pair', { accept: /^y/i.test(a) });
                }
                if (p.bt && p.bt.error && p.bt.errorAt > Date.now() - 3000) console.log('! ' + p.bt.error);
                await new Promise((res) => setTimeout(res, 1000));
            }
            rl.close();
            return;
        }
        case 'play': case 'pause': case 'next': case 'prev': { await post('/api/phone/media', { action: cmd === 'prev' ? 'previous' : cmd }); console.log(cmd); return; }
        case 'wifi': {
            // carhud-wifi does the switching (as root, in the background so it survives SSH dropping)
            const r = spawnSync('carhud-wifi', args.length ? args : ['status'], { stdio: 'inherit' });
            if (r.error) throw new Error('carhud-wifi not found: run carhud update');
            process.exit(r.status || 0);
        }
        case 'nav': {
            if (args[0] === 'end') { await post('/api/phone/route/clear'); console.log('route ended'); return; }
            if (args[0] === 'stop') { await post('/api/phone/simulate', { speed: 0 }); console.log('test drive stopped'); return; }
            if (args[0] === 'test') {
                const p = await get('/api/phone'), g = p.gps, lat = g ? g.lat : 43.3616, lon = g ? g.lon : -80.3144;
                const dLat = 400 / 111320, dLon = 400 / (111320 * Math.cos(lat * Math.PI / 180));
                const c = [[lon, lat], [lon, lat + dLat], [lon + dLon, lat + dLat], [lon + dLon, lat], [lon, lat]];
                const names = ['Test Ave', 'First St', 'Second St', 'Third St'];
                const steps = [{ type: 'depart', modifier: '', name: names[0], location: c[0], text: 'Head north on Test Ave' }]
                    .concat([1, 2, 3].map((i) => ({ type: 'turn', modifier: 'right', name: names[i], location: c[i], distance: 400, text: 'Turn right onto ' + names[i] })))
                    .concat([{ type: 'arrive', modifier: '', name: '', location: c[4], text: 'Arrive at your destination' }]);
                await post('/api/phone/route', { route: { dest: { name: 'Test loop', lat, lon }, coords: c, steps, distance: 1600, duration: 120 } });
                await post('/api/phone/simulate', { speed: Number(args[1]) || 60 });
                console.log('test loop of 1.6 km, driving it at ' + (Number(args[1]) || 60) + ' km/h (carhud nav stop / carhud nav end)');
                return;
            }
            throw new Error('carhud nav test [kmh] | stop | end');
        }
        case 'restart': { await post('/api/app/restart', { rebuild: args[0] === '--rebuild' }); console.log('restarting the HUD app' + (args[0] === '--rebuild' ? ' (rebuilding)' : '')); return; }
        case 'reload': { await post('/api/displays/reload'); console.log('screens reloading'); return; }
        case 'screens': { const r = spawnSync('carhud-screens', args, { stdio: 'inherit', env: Object.assign({ DISPLAY: ':0' }, process.env) }); process.exit(r.status || 0); }
        case 'update': { const r = spawnSync(path.join(ROOT, 'system', 'carhud-update'), args, { stdio: 'inherit' }); process.exit(r.status || 0); }
        case 'url': {
            const s = await get('/api/system');
            console.log('control panel:  ' + (s.ips.map((x) => 'http://' + x.ip + ':' + s.port + '/').join('   ') || 'no network'));
            console.log('             or http://' + s.hostname + '.local:' + s.port + '/');
            return;
        }
        case 'gears': {
            if (args.length < 3) throw new Error('carhud gears <final drive> <tyre e.g. 245/40R18> <gear ratios...>');
            const fd = Number(args[0]);
            const m = String(args[1]).match(/^(\d{3})\/(\d{2})\D*R?(\d{2})$/i);
            if (!m) throw new Error('tyre size like 245/40R18');
            const diaMm = Number(m[3]) * 25.4 + 2 * Number(m[1]) * Number(m[2]) / 100;
            const circ = Math.PI * diaMm / 1000 * 0.97;      // ~3% smaller rolling radius under load
            const per = args.slice(2).map(Number).map((g) => Math.round(1000 / 60 / circ * g * fd * 10) / 10);
            console.log('tyre circumference ~' + circ.toFixed(3) + ' m');
            per.forEach((r, i) => console.log('  gear ' + (i + 1) + ': ' + r + ' rpm per km/h  (' + Math.round(r * 100) + ' rpm at 100 km/h)'));
            console.log('\nPut this in /etc/carhud.conf, then: sudo systemctl restart carhud\n\nOBD_GEAR_RATIOS=' + per.join(','));
            console.log('\nCheck it while driving with `carhud obd` (shows rpm per km/h live).');
            return;
        }
        default: throw new Error('unknown command "' + cmd + '" (carhud help)');
    }
}

/** Bluetooth troubleshooting on the Pi: each piece pairing needs, checked in order. */
async function btCheck() {
    const run = (cmd, a) => { const r = spawnSync(cmd, a, { encoding: 'utf8' }); return { ok: r.status === 0, out: ((r.stdout || '') + (r.stderr || '')).trim(), missing: !!r.error }; };
    const line = (ok, what, fix) => console.log((ok ? '  ok    ' : '  FIX   ') + what + (ok || !fix ? '' : '\n          → ' + fix));
    console.log('Bluetooth check');
    const svc = run('systemctl', ['is-active', 'bluetooth']);
    line(svc.out === 'active', 'bluetooth service: ' + svc.out, 'sudo systemctl enable --now bluetooth');
    const rf = run('rfkill', ['list', 'bluetooth']);
    const blocked = /Soft blocked: yes/.test(rf.out) ? 'soft' : /Hard blocked: yes/.test(rf.out) ? 'hard' : null;
    line(!rf.missing && !blocked && rf.out, rf.missing ? 'rfkill not installed' : !rf.out ? 'no Bluetooth radio listed by rfkill' : 'radio ' + (blocked ? blocked + ' blocked' : 'not blocked'),
        rf.missing ? 'sudo apt install rfkill' : blocked === 'soft' ? 'sudo rfkill unblock bluetooth' : !rf.out ? 'the radio is missing: check /boot/firmware/config.txt has no dtoverlay=disable-bt, then reboot' : 'sudo apt install rfkill');
    const show = run('bluetoothctl', ['show']);
    const powered = /Powered: yes/.test(show.out), name = (show.out.match(/Alias: (.*)/) || [])[1];
    line(show.ok && /Controller/.test(show.out), 'adapter: ' + (show.ok && /Controller/.test(show.out) ? (show.out.match(/Controller ([0-9A-F:]+)/) || [])[1] : 'none'), 'no adapter: sudo systemctl restart bluetooth; if it stays missing: sudo reboot');
    line(powered, 'powered: ' + (powered ? 'yes' : 'no'), 'bluetoothctl power on');
    if (name) line(true, 'name phones see: ' + name);
    const groups = run('id', ['-nG']).out.split(/\s+/);
    line(groups.includes('bluetooth'), 'user in the bluetooth group', 'sudo usermod -aG bluetooth $USER, then sudo systemctl restart carhud');
    const py = run('python3', ['-c', 'import dbus, gi']);
    line(py.ok, 'python3-dbus and python3-gi', 'sudo apt install python3-dbus python3-gi');
    const audio = run('systemctl', ['is-active', 'carhud-btaudio']);
    line(audio.out === 'active', 'phone music player (carhud-btaudio): ' + audio.out, 'carhud update (installs bluez-alsa), or: journalctl -u carhud-btaudio');
    try {
        const p = await get('/api/phone'), bt = p.bt || {};
        line(bt.available, 'CarHUD Bluetooth helper: ' + (bt.available ? 'running' : 'not running'), bt.error || 'see: carhud log | grep -i bluetooth');
        if (bt.error) console.log('  last problem: ' + bt.error);
        if (p.lastPair) console.log('  last pairing: ' + p.lastPair.name + (p.lastPair.done ? (p.lastPair.ok ? ' (paired)' : ' (failed)') : ' (in progress)'));
        (bt.devices || []).forEach((d) => console.log('  paired: ' + d.name + ' ' + d.address + (d.connected ? ' (connected)' : '')));
    } catch (e) { line(false, 'CarHUD server', e.message); }
    const logs = await get('/api/logs').catch(() => []);
    const bl = logs.filter((e) => /bluetooth/i.test(e.text)).slice(-8);
    if (bl.length) { console.log('\nrecent Bluetooth log:'); bl.forEach((e) => console.log('  ' + new Date(e.time).toTimeString().slice(0, 8) + ' ' + e.level + ' ' + e.text)); }
}

process.stdout.on('error', (e) => { if (e.code === 'EPIPE') process.exit(0); throw e; });
main().catch((e) => { console.error('carhud: ' + e.message); process.exit(1); });
